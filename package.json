{
  "name": "crosscheck",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "api": "tsx server/index.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "test": "tsx --test tests/*.test.ts",
    "test:prompts": "tsx tests/run.ts",
    "test:moderator": "tsx tests/run.ts moderator",
    "test:personal": "tsx tests/run.ts personal",
    "simulate": "tsx tests/simulate.ts"
  },
  "dependencies": {
    "@stream-io/node-sdk": "^0.9.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stream-chat": "^10.2.0",
    "stream-chat-react": "^15.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
