# .env 로 복사해서 채우세요. .env 는 git 에 올리지 않습니다.

# ---------- 에이전트 (OpenRouter) ----------
# https://openrouter.ai/keys 에서 만든 키. 서버에서만 씁니다.
OPENROUTER_API_KEY=

# Moderator 모델
LLM_MODEL=openai/gpt-6-luna
# Personal Agent 모델 (OpenRouter 에서 strict JSON schema 를 지원해야 함). 비우면 openai/gpt-6-luna
PERSONAL_LLM_MODEL=

# Critic: 체크가 열리기 직전과 답이 갈린 뒤, 더 강한 모델이 질문·후속 질문을 한 번 더 검토. 비우면 anthropic/claude-opus-5.5
# 예: anthropic/claude-fable-5.2, openai/gpt-6.2-astra
CRITIC_LLM_MODEL=
# risk: 코드 검사에서 문제가 보일 때만 (기본) | always: 매번 | off: 끄기
CRITIC_MODE=risk

# gpt-5 계열의 추론 강도: minimal | low | medium | high. 추론이 없는 모델이면 비워 두세요.
LLM_REASONING_EFFORT=low

# 호출당 최대 토큰 (추론 토큰 포함)
LLM_MAX_TOKENS=1500

# 테스트 스크립트의 비용 추정용 (1M 토큰당 가격)
LLM_PRICE_IN=0.1
LLM_PRICE_OUT=0.5

# 선택: Moderator 에만 쓰는 OpenAI 호환 다른 서버 (예: 로컬 Ollama http://localhost:11434/v1)
# LLM_BASE_URL=

# ---------- 서버 ----------
# 계정, 그룹, 회의, 결정, 채팅을 저장하는 폴더 (기본 ./data)
DATA_DIR=
PORT=8787
