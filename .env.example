# .env 로 복사해서 채우세요. .env 는 git 에 올리지 않습니다.

# ---------- 에이전트 (OpenRouter) ----------
# https://openrouter.ai/keys 에서 만든 키. 서버에서만 씁니다.
OPENROUTER_API_KEY=

# Moderator 모델
LLM_MODEL=openai/gpt-5-mini
# Personal Agent 모델 (OpenRouter 에서 strict JSON schema 를 지원해야 함). 비우면 openai/gpt-5-mini
PERSONAL_LLM_MODEL=

# gpt-5 계열의 추론 강도: minimal | low | medium | high. 추론이 없는 모델이면 비워 두세요.
LLM_REASONING_EFFORT=low

# 호출당 최대 토큰 (추론 토큰 포함)
LLM_MAX_TOKENS=1500

# 테스트 스크립트의 비용 추정용 (1M 토큰당 가격)
LLM_PRICE_IN=0.25
LLM_PRICE_OUT=2.0

# 선택: Moderator 에만 쓰는 OpenAI 호환 다른 서버 (예: 로컬 Ollama http://localhost:11434/v1)
# LLM_BASE_URL=

# ---------- 서버 ----------
# 계정, 그룹, 회의, 결정, 채팅을 저장하는 폴더 (기본 ./data)
DATA_DIR=
PORT=8787
