# .env 로 복사해서 채우세요. .env 는 git 에 올리지 않습니다.

# ---------- Stream Chat (그룹 생성/참여, 그룹 채팅 기록 보관) ----------
# https://dashboard.getstream.io 의 Chat 앱 키. secret 은 서버에서만 씁니다.
# 비워 두면 회의방과 에이전트는 동작하지만 채팅이 서버 재시작 후 남지 않습니다.
STREAM_API_KEY=
STREAM_API_SECRET=

# ---------- 에이전트 (OpenRouter) ----------
# https://openrouter.ai/keys 에서 만든 키. 서버에서만 씁니다.
OPENROUTER_API_KEY=

# Moderator 모델. Personal Agent 는 openai/gpt-5-mini 고정입니다 (agents/llm.ts).
LLM_MODEL=openai/gpt-5-mini

# gpt-5 모델의 추론 강도: minimal | low | medium | high. 추론이 없는 모델이면 비워 두세요.
LLM_REASONING_EFFORT=low

# 호출당 최대 토큰. 추론 토큰도 포함되니 너무 낮게 잡지 마세요.
LLM_MAX_TOKENS=1500

# 테스트 스크립트가 보여주는 비용 추정용 (1M 토큰당 가격)
LLM_PRICE_IN=0.25
LLM_PRICE_OUT=2.0

# 선택: OpenAI 호환 다른 서버 (예: 로컬 Ollama http://localhost:11434/v1). Moderator 에만 적용됩니다.
# LLM_BASE_URL=

# 선택: gpt-5 모델은 temperature 를 받지 않으니 비워 두세요.
# LLM_TEMPERATURE=0.2

# API 서버 포트
PORT=8787
