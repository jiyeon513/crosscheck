# Stream Chat — https://dashboard.getstream.io 에서 Chat 앱의 키를 복사한 뒤 .env 로 저장하세요.
# API secret 은 이 서버에서만 쓰고, 브라우저 코드에는 넣지 않습니다.
STREAM_API_KEY=
STREAM_API_SECRET=

# OpenRouter — https://openrouter.ai/keys 에서 키를 만드세요. 서버에서만 사용합니다.
OPENROUTER_API_KEY=

# 개인 에이전트를 연결할 때 쓸 모델 (https://openrouter.ai/models). 비워 두면 openrouter/auto 입니다.
OPENROUTER_PERSONAL_MODEL=

# 선택: OpenRouter 대시보드에 표시될 앱 정보
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=CrossCheck
